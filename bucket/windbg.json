{
    "version": "1.2603.20001.0",
    "description": "WinDbg is a debugger that can be used to analyze crash dumps, debug live user-mode and kernel-mode code, and examine CPU registers and memory.",
    "homepage": "https://learn.microsoft.com/en-us/windows-hardware/drivers/debugger/",
    "license": {
        "identifier": "proprietary",
        "url": "https://learn.microsoft.com/en-us/legal/windows-sdk/windbg-preview---software-license-terms"
    },
    "notes": "Settings are stored in '$env:LocalAppData\\dbg', and are not persisted by Scoop.",
    "url": "https://windbg.download.prss.microsoft.com/dbazure/prod/1-2603-20001-0/windbg.msixbundle",
    "hash": "d98e7027fc84962dcd93c270195e84b27bacfcf942935043fa457c87aea83532",
    "pre_install": [
        "Expand-7zipArchive -Path \"$dir\\$fname\" -DestinationPath \"$dir\\extracted\" -Removal",
        "$arch = $architecture -replace '64bit','x64' -replace '32bit','x86'",
        "Expand-7zipArchive -Path \"$dir\\extracted\\windbg_win-$arch.msix\" -DestinationPath $dir",
        "Remove-Item -Path \"$dir\\extracted\" -Force -Recurse"
    ],
    "bin": [
        [
            "DbgX.Shell.exe",
            "WinDbgX"
        ]
    ],
    "shortcuts": [
        [
            "DbgX.Shell.exe",
            "WinDbg"
        ]
    ],
    "checkver": {
        "url": "https://raw.githubusercontent.com/MicrosoftDocs/windows-driver-docs/refs/heads/staging/windows-driver-docs-pr/debuggercmds/windbg-release-notes.md",
        "regex": "##.* ([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://windbg.download.prss.microsoft.com/dbazure/prod/$dashVersion/windbg.msixbundle"
    }
}
